[Unit]
Description=Reelia - plataforma web
After=network.target

[Service]
User=reelia
Group=reelia
WorkingDirectory=/opt/reelia/reelia/web
EnvironmentFile=/etc/reelia.env
ExecStart=/opt/reelia/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8765 --timeout 120 app:app
Restart=always

[Install]
WantedBy=multi-user.target
